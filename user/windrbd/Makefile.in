# This is a very simple makefile
# TODO: raise error if WITH_WINDRBD is not set
# TODO: set CC to gcc or do not use build in .c.o rule

sbindir = @sbindir@
sysconfdir = @sysconfdir@
WITH_WINDRBD = @WITH_WINDRBD@

# variables meant to be overridden from the make command line
ifeq ($(WITH_WINDRBD),yes)
DESTDIR ?=
else
# This does not make sense ...
DESTDIR ?= /
endif

CFLAGS=-g -Wall -I../shared -I../../drbd-headers
# TODO: is this also here needed?
ifeq ($(WITH_WINDRBD),yes)
CFLAGS += -I../windrbd-fake-headers
endif
OBJS=windrbd.o shared_windrbd.o

all: windrbd

shared_windrbd.o: ../shared/shared_windrbd.c
	gcc -c $(CFLAGS) -o $@ $^

windrbd: $(OBJS)
	gcc $(CFLAGS) -o windrbd.exe $(OBJS)

install: windrbd
	install -m 755 windrbd.exe $(DESTDIR)$(sbindir)
	install -m 644 windrbd-sample.res $(DESTDIR)$(sysconfdir)/drbd.d

clean:
	rm -f windrbd.exe

distclean:
