## A wait-connect runs without a timeout. An earlier command's timeout
## (cmd-timeout-short 1) must not abort it, nor the rest of the adjust.
$ FAKE_DRBDSETUP_SHOW=drbdsetup_show_switch_interface_r0.txt drbdadm --drbdsetup ./drbdsetup_slow_wait -c <(sed '1i global { cmd-timeout-short 1; }' adjust_switch_interface_r0.res) adjust r0 2>/dev/null; echo $?
disconnect r0 0
del-path r0 0
new-path r0 0
connect r0 0
wait-connect-connection r0 0
disconnect r0 1
del-path r0 1
new-path r0 1
connect r0 1
0
