#!/bin/sh
# This systemd.generator(7) creates systemd dependencies for drbd@.service(7) based on drbd.conf(5)
# In addition, it links all drbd@.target(7) to drbd-configured.target.

OUTDIR="$1"
TARGET_REQUIRES_DIR="${OUTDIR}/drbd-configured.target.requires"

test -d "${OUTDIR}" || { echo "No valid output directory: '$OUTDIR'" >&2 ; exit 1; }
command -v drbdadm >/dev/null || { echo "No drbdadm command found" >&2 ; exit 0; }
command -v systemd-escape >/dev/null  || { echo "No systemd-escape command found": exit 0; }

backing_device_override() {
	RES="${1}"
	# TODO: SourcePath should point to correct resource file(s)
	cat <<EOF
# Automatically generated by drbd-generator(8)
[Unit]
SourcePath=/etc/drbd.conf
EOF

	for DEV in $(drbdadm sh-ll-dev "${RES}" | grep -v '^none$'); do
		ESCAPED_DEV="$(systemd-escape -p "${DEV}" --suffix=device)"
		cat <<EOF
# Dependency on backing device ${DEV}
After=${ESCAPED_DEV}
Requires=${ESCAPED_DEV}
EOF
	done

	for META_DEV in $(drbdadm sh-md-dev "${RES}"); do
		ESCAPED_META_DEV="$(systemd-escape -p "${META_DEV}" --suffix=device)"
		cat <<EOF
# Dependency on backing device ${META_DEV}
After=${ESCAPED_META_DEV}
Requires=${ESCAPED_META_DEV}
EOF
	done
}

mkdir -p "${TARGET_REQUIRES_DIR}"
for RES in $(drbdadm sh-resources) ; do
	SERVICE_NAME="$(systemd-escape --template="drbd@.service" "${RES}")"
	TARGET_NAME="$(systemd-escape --template="drbd@.target" "${RES}")"
	SERVICE_OVERRIDE_DIR="${OUTDIR}/${SERVICE_NAME}.d"

	mkdir -p "${SERVICE_OVERRIDE_DIR}"
	backing_device_override "${RES}" > "${SERVICE_OVERRIDE_DIR}/backing-devices.conf"
	ln -snf /lib/systemd/system/drbd@.target "${TARGET_REQUIRES_DIR}/${TARGET_NAME}"
done
